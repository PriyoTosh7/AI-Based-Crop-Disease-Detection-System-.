# PostgreSQL connection string from your hosted PostgreSQL provider.
# Use the provider's pooled connection URL if it supplies one.
DATABASE_URL=

# Public direct-download URL for the trained .pth checkpoint (e.g. Hugging Face resolve URL).
# The model is intentionally excluded from Git because it is larger than GitHub's 100 MB file limit.
PV_CHECKPOINT_URL=
PV_CHECKPOINT_PATH=checkpoints/best_finetuned_efficientnet_b3.pth
PV_CHECKPOINT_SHA256=93625042ede1533f3a3cb563fe1432f3c3460532cf9cbbffe3bf9c269633dc4e

# Only needed if the frontend is hosted on a different origin. Comma-separated origins.
FRONTEND_ORIGINS=
PV_DATASET_DIR=
PV_PROCESSED_DIR=dataset/processed
PV_NUM_WORKERS=0
MAX_UPLOAD_MB=10
TORCH_NUM_THREADS=2

# Grad-CAM image cleanup retention (hours).
GRADCAM_RETENTION_HOURS=24
